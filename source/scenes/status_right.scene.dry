@status
on-arrival: {!
if (Q.rfb_rb_unity) {
    Q.rfb_rb_unity_2 = ( Q.rfb_rb_unity.toFixed(2) ) * 100;
}
if (Q.left_sympathies) {
    Q.left_sympathies_2 = ( Q.left_sympathies.toFixed(2) ) * 100;
}
if (Q.bourgeois_left_willingness) {
    Q.bourgeois_left_willingness_2 = ( Q.bourgeois_left_willingness.toFixed(2) ) * 100;
}
!}

