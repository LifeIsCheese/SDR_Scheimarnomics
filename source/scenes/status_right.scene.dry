title: status_right
new-page: true
is-special: true

= The Military

Military Strength: [+ military_strength +]%

Military Weariness: [+ military_weariness +]% 

[? if military_available < 0.25 : The military is coalescing and getting tired of the current deadlock. ?] [? if military_available >= 0.25 and military_available < 0.5 : The military has enforced discipline. ?] [? if military_available >= 0.5 and military_available < 0.75 : The military is split. ?] [? if military_available >= 0.75 : The military is racked with ideological infighting. ?]


= Concessions

[? if military_concessions == 0 : None ?] [? if military_concessions == 1 : Promised funding. ?] [? if military_concessions == 2 : An increase in military spending. ?] [? if military_concessions >= 3 : Military delegation, in dealing with the extremists. ?] [? if military_concessions == 4 : Further military spending. ?] [? if military_concessions >= 5 : Military overwatch regarding counter paramilitary operations. ?]

Military Influence [+ military_influence +]%

@reichsbanner

= Reichsbanner

<div class = "face-status-container">
    [? if rb_leader == "otto horsing" : <img class="face-status" src="img/portraits/Otto_Horsing_1932.jpg"> ?]
</div>

[? if rb_leader == "otto horsing" : <p style="text-align: center;">Chairman Otto Hörsing</p> ?]
[? if rb_leader == "otto horsing" : <p style="text-align: center;">Assassination: [+ horsing_death +]%</p> ?]
[? if rb_leader != "vacant" : <button class = "status_button_wide" onclick ="rb_actions()">Chairman Actions</button> ?]

<div class = "face-status-container">
    <img class="face-status" src="img/portraits/Karl_Holtermann_1932.jpg"> 
</div>

[? if rb_leader == "otto horsing" : <p style="text-align: center;">Deputy Karl Höltermann</p> ?] [? if rb_leader == "karl holtermann" : <p style="text-align: center;">Chairman Karl Höltermann</p> ?]
[? if rb_leader != "vacant" : <p style="text-align: center;">Assassination: [+ holtermann_death +]%</p> ?]

Current Reichsbanner Dissent: [+ rb_dissent +]%

@Actions_rb

= [? if rb_leader == "otto horsing" : <span style="color: rgb(199, 197, 69);">**Otto Hörsing**</span> ?] [? if rb_leader == "karl holtermann" : <span style="color: rgb(199, 197, 69);">**Karl Höltermann**</span> ?]

[? if rb_leader != "vacant" and rb_actions_timer == 0 and hiding == 0 : <button class = "status_button_wide" onclick ="dissent_reduction()">Rally</button> ?]

[? if rb_actions_timer == 0 and rb_leader != "vacant" and hiding == 0  : Decreases Reichsbanner dissent by [? if rb_leader == "otto horsing" : 33% ?] [? if rb_leader == "karl holtermann" : 15% ?]. ?]

[? if rb_leader != "vacant" and rb_actions_timer == 0 and hiding == 0 : <button class = "status_button_wide" onclick ="republic_unity()">Republican Cooperation</button> ?]

[? if rb_actions_timer == 0 and rb_leader != "vacant" and hiding == 0  : Increase passive Reichsbanner growth by [? if rb_leader == "otto horsing" : 3 ?] [? if rb_leader == "karl holtermann" : 6 ?] thousand members per month. ?]

[? if rb_leader != "vacant" and hiding == 0: <button class = "status_button_wide" onclick ="hide()">Go into hiding</button> ?]

[? if hiding == 0 and rb_leader != "vacant" : Be at a far lower risk at getting assassinated. But unable to do actions. ?]

[? if rb_leader != "vacant" and hiding == 1: <button class = "status_button_wide" onclick ="show()">Get out of hiding</button> ?]

[? if hiding == 1 and rb_leader != "vacant" : Be able to do actions, but be at a far greater risk of getting assassinated.  ?]

[? if rb_actions_timer > 0 and rb_leader != "vacant" and hiding == 0 : Sorry but [+ rb_leader +] is busy, please wait [+ rb_actions_timer +] months. ?]




[? if started: [? if z_party_name != "CVP": <span class="tooltip-text" title="Center Party + Bavarian People's Party"><span style="color: #000000;">**[+ z_party_name +]**</span> + <span style="color: #A2D8E0;">**BVP**</span></span>?][? if z_party_name == "CVP": <span class="tooltip-text" title="Christian People's Party + Bavarian People's Party"><span style="color: #000000;">**[+ z_party_name +]**</span> + <span style="color: #A2D8E0;">**BVP**</span></span>?]?][? if not started: <span class="tooltip-text" title="Center Party + Bavarian People's Party"><span style="color: #000000;">**Z**</span> + <span style="color: #A2D8E0;">**BVP**</span></span> ?]: [+ z_r +]%

