@party
title: Party Affairs
card-image: img/Vorwaerts_nr_1.png
is-deck: true

- #party_affairs

@govt
title: Government Affairs
view-if: time >= 6 and spd_bd_position != "support_kpd"
card-image: img/reichstag_2.jpg
is-deck: true

- #govt_affairs

@paramilitaries
view-if: violence_timer > 0 and spd_bd_position !="support_kpd"
title: Fighting the Paramilitaries
card-image: img/anti_paramillitary.jpg
is-deck: true

- #fighting_paramilitaries

@agitation
view-if: violence_timer > 0 and spd_bd_position == "support_kpd"
title: Agitation
card-image: img/d_rose.jpg
is-deck: true

- #agitation

@confrontation
title: Shuffle Leadership
view-if: 1 == 1
new-page: true
is-card: true
is-pinned-card: true
on-arrival: month_activities += 1; shuffle_leadership_timer = 6;
card-image: img/vorwarts_2.jpg
go-to: shuffle_leadership.rm_main

